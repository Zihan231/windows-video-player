<Window x:Class="XRPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XRPlayer"
        Title="WinPlayer" Icon="app.png" Width="1180" Height="720" MinWidth="720" MinHeight="420"
        Background="{StaticResource Bg}" AllowDrop="True" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto" x:Name="BarRow"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto" x:Name="ListCol"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Background="Black">
      <Grid>
        <local:MpvHost x:Name="Host"/>
        <!-- Empty-state: shown instead of the video surface (a native video window would cover it) -->
        <Border x:Name="DropZone" Background="#0E0F13" Cursor="Hand" MouseLeftButtonUp="DropZone_Click" AllowDrop="True">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="app.png" Width="112" Height="112" Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="WinPlayer" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <Border x:Name="DropBox" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="14" Padding="34,22" Margin="0,26,0,0" Background="#12141A">
              <StackPanel>
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop a video here" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="or click to choose a file" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Playlist -->
    <Border x:Name="ListPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="300" Background="{StaticResource Panel}" Visibility="Collapsed">
      <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Content="Clear" Style="{StaticResource TextBtn}" DockPanel.Dock="Right" Click="ClearList_Click"/>
          <Button Content="Add files" Style="{StaticResource TextBtn}" DockPanel.Dock="Right" Margin="0,0,6,0" Click="AddFiles_Click"/>
          <TextBlock Text="Playlist" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}" MouseDoubleClick="List_DoubleClick"/>
      </DockPanel>
    </Border>

    <!-- Control bar -->
    <Border x:Name="Bar" Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" Padding="14,8,14,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <TextBlock x:Name="TimeL" Text="0:00" Foreground="{StaticResource Dim}" Width="58" VerticalAlignment="Center"/>
          <TextBlock x:Name="TimeR" Text="0:00" Foreground="{StaticResource Dim}" Width="58" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          <Slider x:Name="Seek" Minimum="0" Maximum="1000" Height="22" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                  PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up" PreviewMouseMove="Seek_Move"/>
        </DockPanel>
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Previous (P)" Click="Prev_Click"/>
            <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="20" ToolTip="Play / Pause (Space)" Click="Play_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Next (N)" Click="Next_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE71A;" ToolTip="Stop" Click="Stop_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE8DA;" ToolTip="Open file (Ctrl+O)" Click="Open_Click"/>
            <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Content="&#xE767;" ToolTip="Mute (M)" Click="Mute_Click"/>
            <Slider x:Name="Vol" Width="90" Minimum="0" Maximum="130" Value="80" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="Vol_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <ComboBox x:Name="SpeedBox" Width="70" Margin="0,0,8,0" SelectionChanged="Speed_Changed" ToolTip="Playback speed"/>
            <ComboBox x:Name="AudioBox" Width="130" Margin="0,0,8,0" SelectionChanged="Audio_Changed" ToolTip="Audio track"/>
            <Button x:Name="SubBtn" Style="{StaticResource IconBtn}" Content="&#xED1E;" ToolTip="Subtitles (V)" Click="Sub_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE8FD;" ToolTip="Playlist (L)" Click="ListToggle_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE722;" ToolTip="Screenshot (S)" Click="Shot_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Settings (Ctrl+,)" Click="Settings_Click"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE740;" ToolTip="Fullscreen (F)" Click="Full_Click"/>
          </StackPanel>
          <TextBlock x:Name="NowPlaying" Text="Open a video or drop one here" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Quick subtitle popup -->
    <Popup x:Name="SubPop" PlacementTarget="{Binding ElementName=SubBtn}" Placement="Top" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-150">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Hover}" BorderThickness="1" CornerRadius="12" Padding="16" Width="360" Margin="8">
        <StackPanel>
          <TextBlock Text="Subtitles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Subtitle 1" Foreground="{StaticResource Dim}"/>
          <DockPanel Margin="0,2,0,8">
            <Button Content="+ file" Style="{StaticResource TextBtn}" DockPanel.Dock="Right" Margin="6,0,0,0" Tag="1" Click="AddSub_Click"/>
            <ComboBox x:Name="Sid1" SelectionChanged="Sid1_Changed"/>
          </DockPanel>
          <TextBlock Text="Subtitle 2" Foreground="{StaticResource Dim}"/>
          <DockPanel Margin="0,2,0,8">
            <Button Content="+ file" Style="{StaticResource TextBtn}" DockPanel.Dock="Right" Margin="6,0,0,0" Tag="2" Click="AddSub_Click"/>
            <ComboBox x:Name="Sid2" SelectionChanged="Sid2_Changed"/>
          </DockPanel>
          <TextBlock Text="Layout" Foreground="{StaticResource Dim}"/>
          <ComboBox x:Name="LayoutBox" Margin="0,2,0,10" SelectionChanged="Layout_Changed">
            <ComboBoxItem Tag="Stacked">Stacked together (one block)</ComboBoxItem>
            <ComboBoxItem Tag="TopBottom">Sub 1 bottom, Sub 2 top</ComboBoxItem>
            <ComboBoxItem Tag="Custom">Custom positions</ComboBoxItem>
          </ComboBox>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Sub 1 delay (s)" Foreground="{StaticResource Dim}"/>
              <TextBox x:Name="Delay1" Margin="0,2,0,0" Height="26" LostFocus="Delay_Changed" KeyDown="Delay_Key"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Sub 2 delay (s)" Foreground="{StaticResource Dim}"/>
              <TextBox x:Name="Delay2" Margin="0,2,0,0" Height="26" LostFocus="Delay_Changed" KeyDown="Delay_Key"/>
            </StackPanel>
          </Grid>
          <Button Content="Customize fonts &amp; style…" Style="{StaticResource TextBtn}" Click="OpenSubSettings_Click"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
